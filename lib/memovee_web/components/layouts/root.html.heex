<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title default="Memovee" suffix=" · Phoenix Framework" phx-no-format>{assigns[:page_title]}</.live_title>
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
  </head>
  <body>
    <nav
      id="account-navigation"
      class="relative z-10 flex min-h-12 items-center justify-end gap-5 border-b border-slate-200 bg-white px-4 text-sm text-slate-600 sm:px-6 lg:px-8"
    >
      <%= if @current_scope do %>
        <span class="hidden text-slate-500 sm:inline">{@current_scope.user.email}</span>
        <.link href={~p"/console/agents"} class="font-medium transition hover:text-sky-800">
          Agents
        </.link>
        <.link href={~p"/users/settings"} class="font-medium transition hover:text-sky-800">
          Settings
        </.link>
        <.link
          href={~p"/auth/session"}
          method="delete"
          class="font-medium transition hover:text-rose-700"
        >
          Log out
        </.link>
      <% else %>
        <.link href={~p"/users/register"} class="font-medium transition hover:text-sky-800">
          Register
        </.link>
        <.link href={~p"/users/log-in"} class="font-medium transition hover:text-sky-800">
          Log in
        </.link>
      <% end %>
    </nav>
    {@inner_content}
  </body>
</html>
