  },
  "environment_loading": {
    "status": "verified",
    "mechanism": "direnv",
    "evidence_path": ".envrc"
  },
  "topology": {
    "profile": "mcp-app-local-https",
    "local_domain": "app.localhost",
    "provider_host": "app.localhost",
    "tama_host": "tama.app.localhost",
    "provider_origin": "https://app.localhost",
    "tama_origin": "https://tama.app.localhost",
    "resource": "https://tama.app.localhost/mcp/app",
    "health_url": "https://tama.app.localhost/",
    "https_port": 443,
    "provider_port": 4000,
    "certificate_names": [
      "app.localhost",
      "tama.app.localhost"
    ],
    "trust_mechanism": "derived-image-ca-certificates",
    "allowed_origins": [
      "https://app.localhost"
    ]
  }
