# Generated by Tama Kit. Copy values into tama/.tama.env; never commit live secrets.

POSTGRES_USER=tama
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=tama
DATABASE_URL=ecto://tama:replace-me@tama-postgres/tama

PHX_HOST=tama.app.localhost
PORT=4000
TAMA_PORT=4000
SECRET_KEY_BASE=replace-me
TAMA_VAULT_KEY=replace-me
TAMA_JWT_SECRET=replace-me
TAMA_OAUTH_PRIVATE_JWK=replace-me
TAMA_OAUTH_PRIVATE_JWK_ID=replace-me
TAMA_SETUP_TOKEN=replace-me

TAMA_DISABLE_CLUSTERING=true
TAMA_OAUTH_ISSUER=https://tama.app.localhost
TAMA_MCP_RESOURCE=https://tama.app.localhost/mcp
TAMA_MCP_ALLOWED_ORIGINS=https://app.localhost
TAMA_BASE_URL=https://tama.app.localhost
TAMA_CLIENT_ID=
TAMA_CLIENT_SECRET=

# MCP App public configuration. Private JWK material is intentionally omitted.
TAMA_MCP_APP_MODE=prepared
TAMA_MCP_APP_AUTHORIZATION_SERVER=https://app.localhost
TAMA_MCP_APP_JWKS_URI=https://app.localhost/.well-known/jwks.json
TAMA_MCP_APP_INTROSPECTION_ENDPOINT=https://app.localhost/auth/introspections
TAMA_MCP_APP_INTROSPECTION_SIGNING_ALGORITHM=RS256
TAMA_MCP_APP_INTROSPECTION_PUBLIC_KEYS=[]
TAMA_MCP_APP_ALLOWED_ORIGINS=https://app.localhost
