#!/usr/bin/env bash
# Development commands only; Terraform validates the graph configuration.
set -euo pipefail
set +x
umask 077
cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."

fail() { printf '%s\n' "$*" >&2; exit 1; }
action=${1:-help}
case "$action" in check|start|stop|plan) ;; *) fail 'Usage: scripts/memory-dev {check|start|stop|plan} [--dry-run]' ;; esac
[[ $# -le 2 && ${2:-} =~ ^(--dry-run)?$ ]] || fail 'Unknown argument'

compose=(docker compose -f compose.yaml -f compose.tama.yaml -f compose.host.yaml)
state=tama/.memory
if [[ ${2:-} == --dry-run ]]; then
  printf 'Configuration: tama/.tama-kit.json, tama/.tama.env, tama/.memory.env, compose.yaml, compose.tama.yaml, compose.host.yaml\n'
  case "$action" in
    plan) printf 'terraform -chdir=tama {init,fmt -check -recursive,validate,plan -out=.memory/memory.tfplan}\n' ;;
    check) printf 'mix run scripts/memory/actor_check.exs\ndocker compose exec: runtime and Redis checks\ncurl: /tama/openapi\n' ;;
    start) printf 'docker compose up --no-deps --no-recreate\nmix ecto.create\nmix ecto.migrate\nmix phx.server\n' ;;
    stop) printf 'Stop recorded container IDs and recorded Phoenix process only\n' ;;
  esac
  exit 0
fi

[[ ! -L "$state" ]] || fail 'Runner state must not be a symlink'
mkdir -p "$state"
for file in lock containers phoenix phoenix.log; do
  [[ ! -L "$state/$file" ]] || fail 'Runner files must not be symlinks'
done
exec 9>"$state/lock"
flock -n 9 || fail 'Another memory-dev command is running'

# Linux process start identity prevents a reused PID from being stopped.
identity() { sed 's/.*) //' "/proc/$1/stat" 2>/dev/null | awk '{print $20}'; }
if [[ $action == stop ]]; then
  if [[ -f "$state/phoenix" ]]; then
    read -r pid started <"$state/phoenix"
    [[ $pid =~ ^[0-9]+$ && $pid -gt 1 && $started =~ ^[0-9]+$ ]] || fail 'Invalid Phoenix ownership record'
    if [[ $(identity "$pid" || true) == "$started" ]]; then
      kill -TERM -- "-$pid"
      for ((attempt=0; attempt<150; attempt++)); do
        [[ $(identity "$pid" || true) == "$started" ]] || break
        sleep 0.1
      done
      [[ $(identity "$pid" || true) != "$started" ]] || fail 'Phoenix has not exited; ownership retained'
    fi
    rm -- "$state/phoenix"
  fi
  if [[ -f "$state/containers" ]]; then
    while read -r id; do
      [[ $id =~ ^[0-9a-f]{64}$ ]] || fail 'Invalid container ownership record'
      docker stop "$id" >/dev/null
    done < <(tac "$state/containers")
    rm -- "$state/containers"
  fi
  exit 0
fi

# Use the existing shell-compatible environment files, including the path
# recorded by Tama Kit. No bespoke dotenv parser or bootstrap rerun is needed.
provider_env=$(jq -er '.mcpAppProvider.environmentFile' tama/.tama-kit.json)
provider_env=$(realpath -m -- "$provider_env")
[[ $provider_env == "$PWD/"* ]] || fail 'Provider environment must remain in this checkout'
set -a
for file in tama/.tama.env "$provider_env" tama/.memory.env; do
  if [[ $file == tama/.memory.env && ! -f $file ]]; then continue; fi
  [[ -f $file ]] || fail 'Required local environment file is missing'
  # shellcheck disable=SC1090
  source "$file" 2>/dev/null || fail 'Unable to load local environment file'
done
set +a
export MIX_ENV=dev PORT=4000 DATABASE_HOST=127.0.0.1
export DATABASE_PORT=${DATABASE_PORT:-5432}
export MEMOVEE_MEMORY_REDIS_URL=${MEMOVEE_MEMORY_REDIS_URL:-redis://127.0.0.1:6380/0}
export TF_VAR_memory_openrouter_api_key=${OPENROUTER_API_KEY:-${TF_VAR_memory_openrouter_api_key:-}}
export MEMORY_PROVIDER_HOST MEMORY_TAMA_HOST
MEMORY_PROVIDER_HOST=$(jq -er '.mcpAppProvider.localHttps.providerHost' tama/.tama-kit.json)
MEMORY_TAMA_HOST=$(jq -er '.mcpAppProvider.localHttps.tamaHost' tama/.tama-kit.json)

if [[ $action == plan ]]; then
  terraform -chdir=tama init -input=false
  terraform -chdir=tama fmt -check -recursive
  terraform -chdir=tama validate
  terraform -chdir=tama plan -input=false -out=.memory/memory.tfplan
  exit 0
fi

docker --version
version=$(docker compose version --short)
version=${version#v}
[[ $(printf '2.20.0\n%s\n' "$version" | sort -V | head -1) == 2.20.0 ]] || fail 'Docker Compose >=2.20.0 is required'
docker info --format '{{.ServerVersion}}'
for key in MEMOVEE_MEMORY_TAMA_ACTOR_ID MEMOVEE_MEMORY_TAMA_API_CREDENTIAL OPENROUTER_API_KEY; do
  [[ -n ${!key:-} ]] || fail "Missing operator configuration: $key"
done

if [[ $action == start ]]; then
  [[ ! -s "$state/containers" && ! -f "$state/phoenix" ]] || fail 'Runner already owns resources; use check or stop'
  [[ -z $("${compose[@]}" ps --status running -q caddy) ]] || fail 'Stop existing Caddy explicitly before changing its provider routing'
  [[ -z $(ss -H -ltn 'sport = :4000') ]] || fail 'Port 4000 is already occupied'
  for service in postgres tama-postgres tama memory-redis caddy; do
    [[ -z $("${compose[@]}" ps --status running -q "$service") ]] || continue
    status=0
    "${compose[@]}" up -d --no-deps --no-recreate "$service" || status=$?
    "${compose[@]}" ps -a -q "$service" >>"$state/containers"
    [[ $status == 0 ]] || fail 'Startup failed; memory-dev stop will clean up owned resources'
    [[ $service != caddy ]] || continue
    for ((attempt=0; attempt<60; attempt++)); do
      id=$("${compose[@]}" ps -q "$service")
      health=$(docker inspect --format '{{if .State.Health}}{{.State.Health.Status}}{{else}}{{.State.Status}}{{end}}' "$id")
      [[ $health == healthy || $health == running ]] && break
      sleep 1
    done
    [[ $health == healthy || $health == running ]] || fail "Service not ready: $service"
  done
  mix ecto.create
  mix ecto.migrate
  setsid mix phx.server 9>&- </dev/null >"$state/phoenix.log" 2>&1 &
  pid=$!
  printf '%s %s\n' "$pid" "$(identity "$pid")" >"$state/phoenix"
  ready=false
  for ((attempt=0; attempt<60; attempt++)); do
    if curl -fsS --max-time 2 http://127.0.0.1:4000/ >/dev/null 2>&1; then ready=true; break; fi
    sleep 1
  done
  [[ $ready == true ]] || fail 'Phoenix did not become ready; inspect the private runner log'
fi

# Runtime checks are separate from Terraform configuration validation.
mix run scripts/memory/actor_check.exs
runtime=$("${compose[@]}" exec -T tama bin/tama rpc "$(cat scripts/memory/runtime_check.exs)")
[[ $runtime == *MEMORY_RUNTIME_READY* ]] || fail 'Runtime dependencies or loaded memory worker queues are missing'
redis=("${compose[@]}" exec -T memory-redis redis-cli --raw)
[[ $("${redis[@]}" PING) == PONG ]] || fail 'Redis is unavailable'
probe="memovee:capability:$(cat /proc/sys/kernel/random/uuid)"
[[ $("${redis[@]}" FT.CREATE "$probe" ON HASH PREFIX 1 "$probe:" SCHEMA body TEXT) == OK ]] || fail 'Redis Search is unavailable'
trap '"${redis[@]}" FT.DROPINDEX "$probe" >/dev/null' EXIT
[[ $("${redis[@]}" FT.SEARCH "$probe" '*' LIMIT 0 0) == 0 ]] || fail 'Redis Search probe failed'
provider_origin=$(jq -er '.mcpAppProvider.localHttps.providerOrigin' tama/.tama-kit.json)
curl -fsS --max-time 10 --cacert tama/tls/rootCA.pem "$provider_origin/tama/openapi" |
  jq -e '[.paths[][] | objects | .operationId] as $ids |
    ["memory_ingestion_open", "memory_ingestion_status", "memory_post_create", "memory_search",
     "memory_projection_snapshot", "memory_projection_complete"] - $ids | length == 0' >/dev/null ||
  fail 'Required memory backend operations are not available'
printf 'Runtime prerequisites verified; integrated graph acceptance is separate.\n'
