{$MEMORY_PROVIDER_HOST} {
  tls /etc/tama-kit/tls/local.pem /etc/tama-kit/tls/local-key.pem
  reverse_proxy http://host.docker.internal:4000 {
    header_up Host {host}
    header_up X-Forwarded-Proto {scheme}
    header_up X-Forwarded-Host {host}
  }
}
{$MEMORY_TAMA_HOST} {
  tls /etc/tama-kit/tls/local.pem /etc/tama-kit/tls/local-key.pem
  reverse_proxy http://tama:4000 {
    header_up Host {host}
    header_up X-Forwarded-Proto {scheme}
    header_up X-Forwarded-Host {host}
  }
}
